# Environment & Server
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# Database Configuration (MySQL 8.0)
DATABASE_URL="mysql://root:rootpassword@localhost:3307/expense_db"
MYSQL_DATABASE=expense_db
MYSQL_USER=expense_user
MYSQL_PASSWORD=expense_pass
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PORT=3307

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=super-secret-access-token-key-2026
JWT_REFRESH_SECRET=super-secret-refresh-token-key-2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Upload Settings
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880 # 5MB in bytes

# Default Admin Credentials for Seeding
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=AdminPass123!
