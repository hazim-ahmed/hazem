{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@expense-system/shared": ["../../packages/shared/dist/index.d.ts"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"]
}
