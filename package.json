{
  "name": "expense-management-system-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Daily Expense Management and Cash Voucher System",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter ./packages/* build && pnpm --filter ./apps/* build",
    "check-types": "pnpm --recursive run check-types",
    "test": "pnpm --filter api test",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "db:studio": "pnpm --filter api db:studio",
    "sync": "node scripts/sync-repos.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.1.0"
}
